<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Styles.Resources>
        <!-- ══════════════════════════════════════════ -->
        <!--        COLOR PALETTE & THEME DICTIONARIES  -->
        <!-- ══════════════════════════════════════════ -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgGlowDark" Color="#f1f5f9"/>
                    <SolidColorBrush x:Key="BgMain" Color="#ffffff"/>
                    <SolidColorBrush x:Key="BgSidebar" Color="#f8fafc"/>
                    <SolidColorBrush x:Key="BorderDark" Color="#cbd5e1"/>
                    <SolidColorBrush x:Key="CyberTeal" Color="#0284c7"/>
                    <SolidColorBrush x:Key="CyberPink" Color="#d97706"/>
                    <SolidColorBrush x:Key="CyberAmber" Color="#b45309"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>
                    <SolidColorBrush x:Key="TextMain" Color="#1e293b"/>
                    <SolidColorBrush x:Key="TextBright" Color="#0f172a"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgGlowDark" Color="#05070c"/>
                    <SolidColorBrush x:Key="BgMain" Color="#070a11"/>
                    <SolidColorBrush x:Key="BgSidebar" Color="#090d15"/>
                    <SolidColorBrush x:Key="BorderDark" Color="#18202e"/>
                    <SolidColorBrush x:Key="CyberTeal" Color="#22d3ee"/>
                    <SolidColorBrush x:Key="CyberPink" Color="#ff3d8b"/>
                    <SolidColorBrush x:Key="CyberAmber" Color="#ffb020"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#5d7088"/>
                    <SolidColorBrush x:Key="TextMain" Color="#cdd9e8"/>
                    <SolidColorBrush x:Key="TextBright" Color="#eaf3fb"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BgGlowDark" Color="#05070c"/>
                    <SolidColorBrush x:Key="BgMain" Color="#070a11"/>
                    <SolidColorBrush x:Key="BgSidebar" Color="#090d15"/>
                    <SolidColorBrush x:Key="BorderDark" Color="#18202e"/>
                    <SolidColorBrush x:Key="CyberTeal" Color="#22d3ee"/>
                    <SolidColorBrush x:Key="CyberPink" Color="#ff3d8b"/>
                    <SolidColorBrush x:Key="CyberAmber" Color="#ffb020"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#5d7088"/>
                    <SolidColorBrush x:Key="TextMain" Color="#cdd9e8"/>
                    <SolidColorBrush x:Key="TextBright" Color="#eaf3fb"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="BgGlowDark" Color="#05070c"/>
            <SolidColorBrush x:Key="BgMain" Color="#070a11"/>
            <SolidColorBrush x:Key="BgSidebar" Color="#090d15"/>
            <SolidColorBrush x:Key="BorderDark" Color="#18202e"/>
            <SolidColorBrush x:Key="CyberTeal" Color="#22d3ee"/>
            <SolidColorBrush x:Key="CyberPink" Color="#ff3d8b"/>
            <SolidColorBrush x:Key="CyberAmber" Color="#ffb020"/>
            <SolidColorBrush x:Key="TextMuted" Color="#5d7088"/>
            <SolidColorBrush x:Key="TextMain" Color="#cdd9e8"/>
            <SolidColorBrush x:Key="TextBright" Color="#eaf3fb"/>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ══════════════════════════════════════════ -->
    <!--               TEXT STYLES                  -->
    <!-- ══════════════════════════════════════════ -->
    
    <!-- For data telemetry/section tags (e.g., ▚ NAVIGATION, ◤ SYSTEM) -->
    <Style Selector="TextBlock.TechHeader">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource CyberTeal}"/>
        <Setter Property="LetterSpacing" Value="0.15"/>
    </Style>
    
    <Style Selector="TextBlock.TechSubHeader">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{DynamicResource CyberTeal}"/>
        <Setter Property="LetterSpacing" Value="0.15"/>
    </Style>

    <!-- For subtle commentary tags or code paths (e.g., // enter credentials) -->
    <Style Selector="TextBlock.TechComment">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <!-- ══════════════════════════════════════════ -->
    <!--             INPUTS & TEXTBOXES             -->
    <!-- ══════════════════════════════════════════ -->
    <Style Selector="TextBox.CyberInput">
        <Setter Property="Background" Value="{DynamicResource BgMain}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    
    <!-- Focus State Glow -->
    <Style Selector="TextBox.CyberInput:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource CyberTeal}"/>
        <Setter Property="Background" Value="{DynamicResource BgMain}"/>
    </Style>
    
    <!-- Hover State -->
    <Style Selector="TextBox.CyberInput:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}"/>
    </Style>

    <!-- ══════════════════════════════════════════ -->
    <!--                BUTTON STYLES               -->
    <!-- ══════════════════════════════════════════ -->
    
    <!-- Primary Sci-Fi Solid Button (Teal action item) -->
    <Style Selector="Button.CyberPrimary">
        <Setter Property="Background" Value="{DynamicResource CyberTeal}"/>
        <Setter Property="Foreground" Value="{DynamicResource BgMain}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Padding" Value="24,11"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.CyberPrimary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#38bdf8"/>
        <Setter Property="Foreground" Value="{DynamicResource BgMain}"/>
    </Style>

    <!-- Secondary Outline Tech Button -->
    <Style Selector="Button.CyberSecondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.CyberSecondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

</Styles>