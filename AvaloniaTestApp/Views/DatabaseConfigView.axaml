<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaTestApp.ViewModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AvaloniaTestApp.Views.DatabaseConfigView"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Spacing="24" Margin="0">

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Database" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="DATABASE CONFIG" Classes="TechHeader" VerticalAlignment="Center"/>
            </StackPanel>
            
            <TextBlock Text="PostgreSQL Connection"
                       Foreground="{StaticResource TextBright}"
                       FontSize="24"
                       FontWeight="SemiBold"/>
                       
            <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="CodeString" Foreground="{StaticResource TextMuted}" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="Enter your credentials to connect to a database instance." Classes="TechComment" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Border Background="#090d15"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderDark}"
                Padding="24">
            <StackPanel Spacing="0">

                <Grid ColumnDefinitions="*, 16, 120" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Host" Classes="TechHeader"/>
                        <TextBox Text="{Binding Host}"
                                 Watermark="localhost"
                                 Classes="CyberInput"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Port" Classes="TechHeader"/>
                        <TextBox Text="{Binding Port}"
                                 Classes="CyberInput"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6" Margin="0,0,0,16">
                    <TextBlock Text="Database Name" Classes="TechHeader"/>
                    <TextBox Text="{Binding DatabaseName}"
                             Watermark="postgres"
                             Classes="CyberInput"/>
                </StackPanel>

                <Grid ColumnDefinitions="*, 16, *">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Username" Classes="TechHeader"/>
                        <TextBox Text="{Binding Username}"
                                 Watermark="postgres"
                                 Classes="CyberInput"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Password" Classes="TechHeader"/>
                        <TextBox Text="{Binding Password}"
                                 PasswordChar="●"
                                 Watermark="••••••••"
                                 Classes="CyberInput"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,20,0,16"/>

                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding TestConnectionCommand}"
                                Classes="CyberSecondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Connection" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Test connection" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCredentialsCommand}"
                                Classes="CyberPrimary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding ConnectionSuccess}">
            <Grid ColumnDefinitions="Auto, 12, *, 20, Auto, 12, Auto, 20, Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="Select Schema"
                           Classes="TechHeader"
                           VerticalAlignment="Center"/>
                
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Schemas}"
                          SelectedItem="{Binding SelectedSchema}"
                          HorizontalAlignment="Stretch"
                          Background="#070b12"
                          BorderBrush="{StaticResource BorderDark}"
                          BorderThickness="1"
                          CornerRadius="0"
                          Foreground="{StaticResource TextMain}"
                          Height="38">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <TextBlock Grid.Column="4" 
                           Text="Context Col"
                           Classes="TechHeader"
                           VerticalAlignment="Center"/>
                
                <TextBox Grid.Column="6"
                         Text="{Binding ContextCol}"
                         Watermark="branch_mst_id"
                         Width="180"
                         Classes="CyberInput"
                         Height="38"
                         VerticalContentAlignment="Center"/>
                         
                <Button Grid.Column="8"
                        Command="{Binding LoadTablesCommand}"
                        Classes="CyberPrimary"
                        Height="38"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Load Tables &amp; Views" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <material:MaterialIcon Kind="ShieldCheckOutline" Foreground="{StaticResource TextMuted}" Width="12" Height="12" VerticalAlignment="Center"/>
            <TextBlock Text="credentials are stored locally · never transmitted"
                       Classes="TechComment"
                       VerticalAlignment="Center"/>
        </StackPanel>

    </StackPanel>

</UserControl>