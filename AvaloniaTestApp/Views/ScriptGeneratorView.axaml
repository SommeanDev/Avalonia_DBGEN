<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaTestApp.ViewModels"
             xmlns:models="using:AvaloniaTestApp.Models"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:AvaloniaTestApp.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="AvaloniaTestApp.Views.ScriptGeneratorView"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="400, 24, *">

        <Border Grid.Column="0"
                Background="#090d15"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderDark}"
                Padding="24">
            <Grid RowDefinitions="Auto, *, Auto">

                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="CodeBraces" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="GENERATOR" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Script Generator"
                               Foreground="{StaticResource TextBright}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,0,4,0">

                        <Grid ColumnDefinitions="*, 16, *">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Type" Classes="TechHeader"/>
                                <ComboBox ItemsSource="{Binding ScriptTypes}"
                                          SelectedItem="{Binding SelectedScriptType}"
                                          HorizontalAlignment="Stretch"
                                          Background="#070b12"
                                          BorderBrush="{StaticResource BorderDark}"
                                          BorderThickness="1"
                                          CornerRadius="0"
                                          Foreground="{StaticResource TextMain}"
                                          Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMain}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="Template" Classes="TechHeader"/>
                                <ComboBox ItemsSource="{Binding Templates}"
                                          SelectedItem="{Binding SelectedTemplate}"
                                          HorizontalAlignment="Stretch"
                                          Background="#070b12"
                                          BorderBrush="{StaticResource BorderDark}"
                                          BorderThickness="1"
                                          CornerRadius="0"
                                          Foreground="{StaticResource TextMain}"
                                          Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMain}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Procedure Name" Classes="TechHeader"/>
                            <TextBox Text="{Binding ProcedureName}"
                                     Watermark="usp_Order_Save"
                                     Classes="CyberInput"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Master Table" Classes="TechHeader"/>
                            <AutoCompleteBox x:Name="TableSearchBox"
                                             MinHeight="38"
                                             ItemsSource="{Binding DatabaseObjects}"
                                             SelectedItem="{Binding SelectedScriptTable}"
                                             Watermark="Search tables..."
                                             HorizontalAlignment="Stretch"
                                             Background="#070b12"
                                             BorderBrush="{StaticResource BorderDark}"
                                             BorderThickness="1"
                                             CornerRadius="0"
                                             Foreground="{StaticResource TextMain}"
                                             Padding="12,8">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DatabaseObject">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" Padding="0,6"/>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding TemplateRequiresLineTable}">
                            <TextBlock Text="Line Table" Classes="TechHeader"/>
                            <AutoCompleteBox MinHeight="38"
                                             ItemsSource="{Binding DatabaseObjects}"
                                             SelectedItem="{Binding SelectedLineTable}"
                                             Watermark="Search line table..."
                                             HorizontalAlignment="Stretch"
                                             Background="#070b12"
                                             BorderBrush="{StaticResource BorderDark}"
                                             BorderThickness="1"
                                             CornerRadius="0"
                                             Foreground="{StaticResource TextMain}"
                                             Padding="12,8">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DatabaseObject">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" Padding="0,6"/>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,4,0,4"/>

                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="TableColumn" Foreground="{StaticResource CyberTeal}" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock Text="COLUMNS" Classes="TechHeader" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1"
                                    Command="{Binding AddColumnCommand}"
                                    Classes="CyberSecondary"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon Kind="Plus" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Field" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ColumnRowControl/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Button Command="{Binding GenerateSqlCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Classes="CyberPrimary"
                            Padding="14,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="LightningBolt" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Generate SQL" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="#070a11"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderDark}"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto, *">

                <Panel Grid.Row="0" Background="#090d15" Height="46">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <Border Grid.Column="0">
                            <Grid>
                                <Border Height="2"
                                        Background="{StaticResource CyberTeal}"
                                        VerticalAlignment="Bottom"
                                        ZIndex="1"
                                        IsVisible="{Binding ShowGeneratedSql}"/>
                                <Button Command="{Binding ShowGeneratedSqlCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextBright}"
                                        Padding="20,0"
                                        Height="46">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon Kind="FileCodeOutline" Width="14" Height="14" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="Generated SQL" FontFamily="{StaticResource AppFontFamily}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <Border Grid.Column="1">
                            <Grid>
                                <Border Height="2"
                                        Background="{StaticResource CyberTeal}"
                                        VerticalAlignment="Bottom"
                                        ZIndex="1"
                                        IsVisible="{Binding ShowTemplateEditor}"/>
                                <Button Command="{Binding ShowTemplateEditorCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextMain}"
                                        Padding="20,0"
                                        Height="46">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon Kind="SquareEditOutline" Width="14" Height="14" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="Template Editor" FontFamily="{StaticResource AppFontFamily}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <Button Grid.Column="3"
                                Command="{Binding CopySqlCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextMuted}"
                                Padding="16,0"
                                Height="46"
                                ToolTip.Tip="Copy to clipboard">
                            <material:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                    
                    <Border Height="1" Background="{StaticResource BorderDark}" VerticalAlignment="Bottom"/>
                </Panel>

                <Panel Grid.Row="1">

                    <TextBox IsVisible="{Binding ShowGeneratedSql}"
                             Text="{Binding GeneratedSql}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="{StaticResource AppFontFamily}"
                             FontSize="{DynamicResource AppFontSize}"
                             Foreground="{StaticResource TextMain}"
                             Background="#05070c"
                             BorderThickness="0"
                             Padding="24,20"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             CaretBrush="{StaticResource CyberTeal}"/>

                    <Grid IsVisible="{Binding ShowTemplateEditor}"
                          RowDefinitions="*, Auto">
                        <TextBox Grid.Row="0"
                                 Text="{Binding TemplateContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="{StaticResource AppFontFamily}"
                                 FontSize="{DynamicResource AppFontSize}"
                                 Foreground="{StaticResource TextMain}"
                                 Background="#05070c"
                                 BorderThickness="0"
                                 Padding="24,20"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 CaretBrush="{StaticResource CyberTeal}"/>
                                 
                        <Border Grid.Row="1" 
                                Background="#090d15" 
                                MinHeight="46" 
                                BorderThickness="0,1,0,0" 
                                BorderBrush="{StaticResource BorderDark}">
                            <Grid ColumnDefinitions="*, Auto, 12, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="16,0">
                                    <material:MaterialIcon Kind="InformationOutline" Foreground="{StaticResource TextMuted}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TemplateStatusText}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1"
                                        Command="{Binding ReloadTemplateCommand}"
                                        Classes="CyberSecondary"
                                        Padding="14,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Refresh" Width="13" Height="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reload" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Grid.Column="3"
                                        Command="{Binding SaveTemplateCommand}"
                                        Classes="CyberPrimary"
                                        Padding="16,6"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Save Template" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                </Panel>
            </Grid>
        </Border>

    </Grid>
</UserControl>