<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaTestApp.ViewModels"
             xmlns:models="using:AvaloniaTestApp.Models"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:AvaloniaTestApp.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="AvaloniaTestApp.Views.ScriptGeneratorView"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="380, 16, *">

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL — Inputs
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#1e1e1e"
                BorderThickness="0.5"
                BorderBrush="#3e3e42"
                CornerRadius="12"
                Padding="20">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="CodeBraces" Foreground="#1D9E75" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="GENERATOR"
                                   Foreground="#1D9E75"
                                   FontFamily="Monospace"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LetterSpacing="2"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Script Generator"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Medium"/>
                </StackPanel>

                <!-- Scrollable inputs -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">

                        <!-- Type + Template -->
                        <Grid ColumnDefinitions="*, 12, *">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Type" Foreground="#1D9E75" FontSize="12" FontFamily="Monospace" FontWeight="Medium"/>
                                <ComboBox ItemsSource="{Binding ScriptTypes}"
                                          SelectedItem="{Binding SelectedScriptType}"
                                          HorizontalAlignment="Stretch"
                                          Background="#252526"
                                          BorderBrush="#3e3e42"
                                          BorderThickness="0.5"
                                          CornerRadius="8"
                                          Foreground="White">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="White"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="Template" Foreground="#1D9E75" FontSize="12" FontFamily="Monospace" FontWeight="Medium"/>
                                <ComboBox ItemsSource="{Binding Templates}"
                                          SelectedItem="{Binding SelectedTemplate}"
                                          HorizontalAlignment="Stretch"
                                          Background="#252526"
                                          BorderBrush="#3e3e42"
                                          BorderThickness="0.5"
                                          CornerRadius="8"
                                          Foreground="White">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="White"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Procedure Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Procedure Name" Foreground="#1D9E75" FontSize="12" FontFamily="Monospace" FontWeight="Medium"/>
                            <TextBox Text="{Binding ProcedureName}"
                                     PlaceholderText="usp_Order_Save"
                                     Background="#252526"
                                     BorderBrush="#1D9E75"
                                     BorderThickness="0.5"
                                     CornerRadius="8"
                                     Foreground="White"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Master Table -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Master Table" Foreground="#1D9E75" FontSize="12"
                                       FontFamily="Monospace" FontWeight="Medium"/>
                            <AutoCompleteBox x:Name="TableSearchBox"
                                             MinHeight="36"
                                             ItemsSource="{Binding DatabaseObjects}"
                                             SelectedItem="{Binding SelectedScriptTable}"
                                             PlaceholderText="Search tables..."
                                             HorizontalAlignment="Stretch"
                                             Background="#252526"
                                             BorderBrush="#3e3e42"
                                             BorderThickness="0.5"
                                             CornerRadius="8"
                                             Foreground="White"
                                             Padding="12,8">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DatabaseObject">
                                        <TextBlock Text="{Binding Name}" Foreground="White" Padding="0,8"/>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </StackPanel>

                        <!-- Line Table (only shown when template requires it) -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding TemplateRequiresLineTable}">
                            <TextBlock Text="Line Table" Foreground="#1D9E75" FontSize="12"
                                       FontFamily="Monospace" FontWeight="Medium"/>
                            <AutoCompleteBox MinHeight="36"
                                             ItemsSource="{Binding DatabaseObjects}"
                                             SelectedItem="{Binding SelectedLineTable}"
                                             PlaceholderText="Search line table..."
                                             HorizontalAlignment="Stretch"
                                             Background="#252526"
                                             BorderBrush="#3e3e42"
                                             BorderThickness="0.5"
                                             CornerRadius="8"
                                             Foreground="White"
                                             Padding="12,8">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DatabaseObject">
                                        <TextBlock Text="{Binding Name}" Foreground="White" Padding="0,8"/>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </StackPanel>

                        <Border Height="0.5" Background="#3e3e42" Margin="0,4,0,0"/>

                        <!-- Columns header + Add button -->
                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="COLUMNS"
                                       Foreground="#1D9E75"
                                       FontSize="11"
                                       FontFamily="Monospace"
                                       FontWeight="SemiBold"
                                       LetterSpacing="2"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding AddColumnCommand}"
                                    Background="Transparent"
                                    BorderBrush="#3e3e42"
                                    BorderThickness="0.5"
                                    CornerRadius="8"
                                    Foreground="#1D9E75"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <material:MaterialIcon Kind="Plus" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add" FontSize="12" FontFamily="Monospace" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Column rows -->
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ColumnRowControl/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <!-- Generate button -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Button Command="{Binding GenerateSqlCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#1D9E75"
                            BorderThickness="0"
                            CornerRadius="8"
                            Foreground="White"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <material:MaterialIcon Kind="CodeBraces" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Generate SQL" FontSize="13" FontWeight="Medium" FontFamily="Monospace" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL — Output (Generated SQL / Template Editor)
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2"
                Background="#1e1e1e"
                BorderThickness="0.5"
                BorderBrush="#3e3e42"
                CornerRadius="12"
                Padding="0"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto, *">

                <!-- Tab bar -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto, Auto, *, Auto"
                      Background="#161616"
                      Height="44">
                    <Border Grid.Column="0"
                            BorderBrush="#1D9E75"
                            BorderThickness="0,0,0,2">
                        <Button Command="{Binding ShowGeneratedSqlCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Padding="16,0"
                                Height="44">
                            <TextBlock Text="Generated SQL" FontFamily="Monospace" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Border>
                    <Button Grid.Column="1"
                            Command="{Binding ShowTemplateEditorCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#888780"
                            Padding="16,0"
                            Height="44">
                        <TextBlock Text="Template Editor" FontFamily="Monospace" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="3"
                            Command="{Binding CopySqlCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#888780"
                            Padding="12,0"
                            Height="44"
                            ToolTip.Tip="Copy to clipboard">
                        <material:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <Border Grid.Row="0" Height="0.5" Background="#3e3e42" VerticalAlignment="Bottom"/>

                <!-- Output area -->
                <Panel Grid.Row="1">

                    <!-- Generated SQL viewer -->
                    <TextBox IsVisible="{Binding ShowGeneratedSql}"
                             Text="{Binding GeneratedSql}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="{DynamicResource AppFontFamily}"
                             FontSize="{DynamicResource AppFontSize}"
                             Foreground="#D4D4D4"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="20,16"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             CaretBrush="#1D9E75"/>

                    <!-- Template editor -->
                    <Grid IsVisible="{Binding ShowTemplateEditor}"
                          RowDefinitions="*, Auto">
                        <TextBox Grid.Row="0"
                                 Text="{Binding TemplateContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="{DynamicResource AppFontFamily}"
                                 FontSize="{DynamicResource AppFontSize}"
                                 Foreground="#D4D4D4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="20,16"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 CaretBrush="#1D9E75"/>
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*, Auto, 8, Auto"
                              Background="#161616"
                              MinHeight="42">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TemplateStatusText}"
                                       Foreground="#888780"
                                       FontSize="11"
                                       FontFamily="Monospace"
                                       VerticalAlignment="Center"
                                       Margin="16,0"/>
                            <Button Grid.Column="1"
                                    Command="{Binding ReloadTemplateCommand}"
                                    Background="Transparent"
                                    BorderBrush="#3e3e42"
                                    BorderThickness="0.5"
                                    CornerRadius="6"
                                    Foreground="#888780"
                                    Padding="10,5"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <material:MaterialIcon Kind="Refresh" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reload" FontSize="12" FontFamily="Monospace" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding SaveTemplateCommand}"
                                    Background="#1D9E75"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Foreground="White"
                                    Padding="10,5"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <material:MaterialIcon Kind="ContentSave" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Save" FontSize="12" FontFamily="Monospace" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                </Panel>
            </Grid>
        </Border>

    </Grid>

</UserControl>
