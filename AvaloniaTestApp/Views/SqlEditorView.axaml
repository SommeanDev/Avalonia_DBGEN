<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaTestApp.ViewModels"
             xmlns:models="using:AvaloniaTestApp.Models"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="AvaloniaTestApp.Views.SqlEditorView"
             x:DataType="vm:SqlEditorViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding ExecuteQueryCommand}"/>
    </UserControl.KeyBindings>

    <Grid ColumnDefinitions="300, 16, *">

        <Border Grid.Column="0"
                Background="#090d15"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderDark}"
                CornerRadius="0"
                Padding="20">
            <Grid RowDefinitions="Auto, *, Auto">

                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="DatabaseCogOutline" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="SQL CONSOLE" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Query Editor"
                               Foreground="{StaticResource TextBright}"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,0,4,0">

                        <TextBlock Text="SAFETY SWITCHES" Classes="TechHeader"/>

                        <Border Background="#070b12"
                                BorderBrush="{StaticResource BorderDark}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <material:MaterialIcon Grid.Column="0"
                                                       Kind="AlertOctagonOutline"
                                                       Foreground="#E24B4A"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Allow DROP"
                                           Foreground="{StaticResource TextMain}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding AllowDrop}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"/>
                            </Grid>
                        </Border>

                        <Border Background="#070b12"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderDark}"
                                CornerRadius="0"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <material:MaterialIcon Grid.Column="0"
                                                       Kind="AlertOutline"
                                                       Foreground="#EF9F27"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Allow DELETE"
                                           Foreground="{StaticResource TextMain}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding AllowDelete}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"/>
                            </Grid>
                        </Border>

                        <Border Background="#070b12"
                                CornerRadius="0"
                                Padding="12,10"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderDark}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <material:MaterialIcon Grid.Column="0"
                                                       Kind="AlertOutline"
                                                       Foreground="#EF9F27"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Allow TRUNCATE"
                                           Foreground="{StaticResource TextMain}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding AllowTruncate}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,4,0,4"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="ENGINE STATUS" Classes="TechHeader"/>
                            
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{Binding StatusBrush}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                                       
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0" IsVisible="{Binding ExecutionTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <material:MaterialIcon Kind="ClockOutline" Foreground="{StaticResource TextMuted}" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ExecutionTime}" Classes="TechComment" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <material:MaterialIcon Kind="DatabaseOutline" Foreground="{StaticResource TextMuted}" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RowCountText}" Classes="TechComment" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
                    <Button Command="{Binding ExecuteQueryCommand}"
                            IsEnabled="{Binding !IsExecuting}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Classes="CyberPrimary"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Play" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Execute Query (F5)" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearQueryCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Classes="CyberSecondary"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Broom" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear Workspace" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Column="2" RowDefinitions="*, 16, *">

            <Border Grid.Row="0"
                    Background="#070a11"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDark}"
                    CornerRadius="0"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto, *">
                    <Panel Grid.Row="0" Background="#090d15" Height="44">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="16,0">
                                <material:MaterialIcon Kind="CodeBraces" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="SQL INPUT STREAM" Classes="TechHeader" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderDark}" VerticalAlignment="Bottom"/>
                    </Panel>

                    <ae:TextEditor Grid.Row="1"
                                   Name="SqlTextEditor"
                                   ShowLineNumbers="True"
                                   FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                   FontSize="13.5"
                                   Background="Transparent"
                                   Foreground="{StaticResource TextMain}"
                                   Padding="8,12"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#070a11"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDark}"
                    CornerRadius="0"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto, *">
                    <Panel Grid.Row="0" Background="#090d15" Height="44">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="16,0">
                                <material:MaterialIcon Kind="Table" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="DATA OUTPUT CELL TRACKS" Classes="TechHeader" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RowCountText}"
                                       Classes="TechComment"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderDark}" VerticalAlignment="Bottom"/>
                    </Panel>

                    <Panel Grid.Row="1">
                        <dg:DataGrid Name="ResultGrid"
                                     IsReadOnly="True"
                                     GridLinesVisibility="All"
                                     HeadersVisibility="Column"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextMain}"
                                     BorderThickness="0"
                                     FontFamily="{DynamicResource AppFontFamily}"
                                     FontSize="{DynamicResource AppFontSize}"/>

                        <ScrollViewer Name="StatementBreakdownPanel"
                                      IsVisible="False"
                                      Margin="0">
                            <ItemsControl ItemsSource="{Binding StatementResults}" Padding="16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SqlStatementResult">
                                        <Border Background="#090d15"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource BorderDark}"
                                                CornerRadius="0"
                                                Padding="14,10"
                                                Margin="0,0,0,10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Statement}"
                                                           Foreground="{StaticResource TextBright}"
                                                           FontFamily="Monospace"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="Monospace"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>