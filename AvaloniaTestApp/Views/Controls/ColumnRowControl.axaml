<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaTestApp.ViewModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="AvaloniaTestApp.Views.Controls.ColumnRowControl"
             x:DataType="vm:ColumnViewModel">

    <!--
        Represents a single column row in the Script Generator column list.
        DataContext = ColumnViewModel (set by the parent ItemsControl DataTemplate).
        The Remove button opts out of compiled bindings so it can walk up to
        MainWindowViewModel via the $parent[ItemsControl] ancestor expression.
    -->
    <Border Background="#252526"
            BorderBrush="#3e3e42"
            BorderThickness="0.5"
            CornerRadius="8"
            Padding="10,8"
            Margin="0,0,0,6">
        <Grid RowDefinitions="Auto, 6, Auto">

            <!-- Row 0: USE checkbox + column name + data type badge + remove button -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding UseColumn}"
                          Content="USE"
                          Foreground="#888780"
                          FontSize="11"
                          FontFamily="Monospace"
                          Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ColumnName}"
                               Foreground="White"
                               FontFamily="Monospace"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Border Background="#1a3a2a" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding DataType}"
                                   Foreground="#1D9E75"
                                   FontFamily="Monospace"
                                   FontSize="11"/>
                    </Border>
                </StackPanel>

                <!--
                    Remove button: opts out of compiled bindings (x:CompileBindings="False")
                    so the $parent[ItemsControl].DataContext ancestor lookup works at runtime.
                -->
                <Button Grid.Column="2"
                        x:CompileBindings="False"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveColumnCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#5F5E5A"
                        Padding="4"
                        Width="22" Height="22">
                    <material:MaterialIcon Kind="Close" Width="12" Height="12"/>
                </Button>
            </Grid>

            <!-- Row 2: Flags + Default value -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsNull}"
                          Content="NULL" Foreground="#888780"
                          FontSize="10" FontFamily="Monospace" Margin="0,0,6,0"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsPK}"
                          Content="PK" Foreground="#888780"
                          FontSize="10" FontFamily="Monospace" Margin="0,0,6,0"/>
                <CheckBox Grid.Column="2" IsChecked="{Binding IsID}"
                          Content="ID" Foreground="#888780"
                          FontSize="10" FontFamily="Monospace" Margin="0,0,6,0"/>
                <CheckBox Grid.Column="3" IsChecked="{Binding IsArray}"
                          Content="ARRAY" Foreground="#888780"
                          FontSize="10" FontFamily="Monospace" Margin="0,0,10,0"/>
                <TextBox Grid.Column="5"
                         Text="{Binding DefaultValue}"
                         Watermark="Default"
                         Background="#1e1e1e"
                         BorderBrush="#3e3e42"
                         BorderThickness="0.5"
                         CornerRadius="6"
                         Foreground="#888780"
                         FontSize="11"
                         FontFamily="Monospace"
                         Padding="8,0"
                         Width="90"
                         Height="26"
                         VerticalContentAlignment="Center"/>
            </Grid>

        </Grid>
    </Border>

</UserControl>
