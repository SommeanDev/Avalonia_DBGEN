<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaTestApp.ViewModels"
             xmlns:models="using:AvaloniaTestApp.Models"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="AvaloniaTestApp.Views.ViewBuilderView"
             x:DataType="vm:ViewBuilderViewModel">

    <Grid RowDefinitions="Auto, *, Auto">

        <Border Grid.Row="0"
                Background="#090d15"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto, 12, Auto, 16, Auto, 12, Auto, 12, Auto, 12, Auto, 12, Auto">

                <TextBlock Grid.Column="0"
                           Text="View Name"
                           Classes="TechHeader"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Column="2"
                         Text="{Binding ViewName}"
                         Width="180"
                         Classes="CyberInput"
                         Height="34"
                         VerticalContentAlignment="Center"/>

                <AutoCompleteBox Grid.Column="4"
                                 ItemsSource="{Binding AvailableTables}"
                                 SelectedItem="{Binding SelectedTableToAdd}"
                                 Width="240"
                                 MinHeight="34"
                                 Background="#070b12"
                                 BorderBrush="{StaticResource BorderDark}"
                                 BorderThickness="1"
                                 CornerRadius="0"
                                 Foreground="{StaticResource TextMain}"
                                 Watermark="Search tables...">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DatabaseObject">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextMain}"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="12"
                                       Margin="0,6"/>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>

                <Button Grid.Column="6"
                        Command="{Binding AddTableCommand}"
                        Classes="CyberPrimary"
                        Height="34"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Table" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="8"
                        Command="{Binding AddCteNodeCommand}"
                        Classes="CyberSecondary"
                        Height="34"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="SourceBranch" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Add CTE" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="10"
                        Command="{Binding GenerateSqlCommand}"
                        Classes="CyberSecondary"
                        Height="34"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="LightningBolt" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Generate View" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="12"
                        Command="{Binding CopySqlCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextMuted}"
                        Height="34"
                        Padding="8,0"
                        ToolTip.Tip="Copy SQL to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="Check" Foreground="{DynamicResource CyberTeal}" Width="15" Height="15" IsVisible="{Binding IsCopied}" VerticalAlignment="Center"/>
                        <TextBlock Text="Copied!" Foreground="{DynamicResource CyberTeal}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding IsCopied}" VerticalAlignment="Center"/>
                        <material:MaterialIcon Kind="ContentCopy" Width="15" Height="15" IsVisible="{Binding !IsCopied}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*, 1, 320">

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#05070c">
                <Canvas x:Name="TableCanvas" MinWidth="2000" MinHeight="1200">
                    
                    <ItemsControl x:Name="TablesItemsControl" ItemsSource="{Binding Tables}" Width="2000" Height="1200">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{ReflectionBinding X}"/>
                                <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ViewBuilderTable">
                                <Border Width="250"
                                        Background="#090d15"
                                        BorderBrush="{StaticResource BorderDark}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        ClipToBounds="True"
                                        Tag="{Binding}"
                                        Cursor="SizeAll">
                                    <Grid RowDefinitions="Auto, *">

                                        <Panel Grid.Row="0" Background="#0d1321" Height="42">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <material:MaterialIcon Grid.Column="0"
                                                                       Kind="Table"
                                                                       Foreground="{StaticResource CyberTeal}"
                                                                       Width="14" Height="14"
                                                                       Margin="12,0,8,0"
                                                                       VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding TableName}"
                                                               Foreground="{StaticResource TextBright}"
                                                               FontFamily="{StaticResource AppFontFamily}"
                                                               FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Alias}"
                                                               Foreground="{StaticResource CyberTeal}"
                                                               Classes="TechComment" FontSize="10"/>
                                                </StackPanel>
                                                
                                                <Button Grid.Column="2"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveTableCommand}"
                                                        x:DataType="vm:ViewBuilderViewModel"
                                                        CommandParameter="{Binding $parent[Border].Tag}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource TextMuted}"
                                                        Width="34" Height="34"
                                                        Padding="0" Cursor="Arrow">
                                                    <material:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                            <Border Height="1" Background="{StaticResource BorderDark}" VerticalAlignment="Bottom"/>
                                        </Panel>

                                        <ScrollViewer Grid.Row="1" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Cursor="Arrow">
                                            <ItemsControl ItemsSource="{Binding Columns}" Padding="0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ViewColumn">
                                                        <Grid ColumnDefinitions="Auto, Auto, *, Auto" Height="30">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Width="28" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Arrow"/>
                                                            <Panel Grid.Column="1" Width="16" Margin="2,0,6,0" VerticalAlignment="Center">
                                                                <material:MaterialIcon Kind="Key" Foreground="#EF9F27" Width="12" Height="12" IsVisible="{Binding IsPrimaryKey}"/>
                                                                <material:MaterialIcon Kind="LinkVariant" Foreground="{StaticResource TextMuted}" Width="12" Height="12" IsVisible="{Binding IsForeignKey}"/>
                                                            </Panel>
                                                            <TextBlock Grid.Column="2" Text="{Binding ColumnName}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource AppFontFamily}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            
                                                            <Border Grid.Column="3" Background="#0922d3ee" BorderThickness="1" BorderBrush="#22d3ee" Padding="6,2" Margin="4,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DataType}" Foreground="{StaticResource CyberTeal}" FontFamily="{StaticResource AppFontFamily}" FontSize="9" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="CteItemsControl" ItemsSource="{Binding CteNodes}" Width="2000" Height="1200">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{ReflectionBinding X}"/>
                                <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CteNode">
                                <Border Width="290"
                                        Background="#090d15"
                                        BorderBrush="{StaticResource CyberTeal}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        ClipToBounds="True"
                                        Tag="{Binding}"
                                        Cursor="SizeAll">
                                    <Grid RowDefinitions="Auto, *">
                                        <Panel Grid.Row="0" Background="#0d1321" Height="44">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <material:MaterialIcon Grid.Column="0"
                                                                       Kind="SourceBranch"
                                                                       Foreground="{StaticResource CyberTeal}"
                                                                       Width="14" Height="14"
                                                                       Margin="12,0,8,0"
                                                                       VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,2,0,0">
                                                    <TextBox Text="{Binding Name}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="{StaticResource TextBright}"
                                                             FontFamily="{StaticResource AppFontFamily}"
                                                             FontSize="12" FontWeight="SemiBold"
                                                             Padding="0" Cursor="Arrow"/>
                                                    <ComboBox ItemsSource="{Binding AvailableSourceTables}"
                                                              SelectedItem="{Binding SourceTableAlias}"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Foreground="{StaticResource CyberTeal}"
                                                              FontFamily="{StaticResource AppFontFamily}"
                                                              FontSize="10" MinHeight="16"
                                                              Padding="0" Cursor="Arrow"/>
                                                </StackPanel>
                                                
                                                <Button Grid.Column="2"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCteNodeCommand}"
                                                        x:DataType="vm:ViewBuilderViewModel"
                                                        CommandParameter="{Binding $parent[Border].Tag}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource TextMuted}"
                                                        Width="34" Height="34"
                                                        Padding="0" Cursor="Arrow">
                                                    <material:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                            <Border Height="1" Background="{StaticResource BorderDark}" VerticalAlignment="Bottom"/>
                                        </Panel>

                                        <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Cursor="Arrow">
                                            <StackPanel Spacing="12" Margin="0,10">
        
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0">
                                                    <material:MaterialIcon Kind="EyeOutline" Foreground="{StaticResource TextMuted}" Width="12" Height="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="PROJECT FIELDS" Classes="TechHeader" FontSize="9"/>
                                                </StackPanel>
                                                
                                                <ItemsControl ItemsSource="{Binding OutputColumns}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ViewColumn">
                                                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" Height="30">
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Width="28" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Arrow"/>
                                                                <Panel Grid.Column="1" Width="16" Margin="2,0,6,0" VerticalAlignment="Center">
                                                                    <material:MaterialIcon Kind="Key" Foreground="#EF9F27" Width="12" Height="12" IsVisible="{Binding IsPrimaryKey}"/>
                                                                    <material:MaterialIcon Kind="LinkVariant" Foreground="{StaticResource TextMuted}" Width="12" Height="12" IsVisible="{Binding IsForeignKey}"/>
                                                                </Panel>
                                                                <TextBlock Grid.Column="2" Text="{Binding ColumnName}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource AppFontFamily}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="3" Background="#0922d3ee" BorderThickness="1" BorderBrush="#22d3ee" Padding="6,2" Margin="4,0,12,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DataType}" Foreground="{StaticResource CyberTeal}" FontFamily="{StaticResource AppFontFamily}" FontSize="9" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid ColumnDefinitions="*, Auto" Margin="12,4,12,0">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <material:MaterialIcon Kind="FilterVariant" Foreground="{StaticResource TextMuted}" Width="12" Height="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="QUERY FILTERS" Classes="TechHeader" FontSize="9" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <Button Grid.Column="1"
                                                            Command="{Binding $parent[ItemsControl].DataContext.AddCteConditionCommand}"
                                                            x:DataType="vm:ViewBuilderViewModel"
                                                            CommandParameter="{Binding $parent[Border;1].Tag}"
                                                            Classes="CyberSecondary"
                                                            Padding="8,4" Cursor="Arrow">
                                                        <material:MaterialIcon Kind="Plus" Width="12" Height="12"/>
                                                    </Button>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Conditions}" Margin="12,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:WhereCondition">
                                                            <StackPanel Spacing="6" Margin="0,0,0,10">
                                                                <ComboBox ItemsSource="{Binding AvailableColumns}"
                                                                          SelectedItem="{Binding SelectedColumn}"
                                                                          Height="34" HorizontalAlignment="Stretch"
                                                                          Background="#070b12" BorderBrush="{StaticResource BorderDark}"
                                                                          BorderThickness="1" CornerRadius="0" Foreground="{StaticResource TextMain}"/>
                                                                <Grid ColumnDefinitions="100, 8, *">
                                                                    <ComboBox Grid.Column="0" ItemsSource="{x:Static models:WhereCondition.Operators}" SelectedItem="{Binding Operator}" Height="34" Background="#070b12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="0" Foreground="{StaticResource TextMain}"/>
                                                                    <TextBox Grid.Column="2" Text="{Binding Value}" Height="34" Watermark="value" Classes="CyberInput"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Canvas>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{StaticResource BorderDark}"/>

            <Border Grid.Column="2" Background="#090d15" Padding="16">
                <Grid RowDefinitions="Auto, 12, *">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="VectorLink" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="RELATIONSHIP LINKS" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" Height="1" Background="{StaticResource BorderDark}"/>
                    
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="// System auto-tracks schema foreign keys on canvas" Classes="TechComment" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#090d15"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="Grid" Foreground="{StaticResource TextMuted}" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="GRID: RECTILINEAR TRACKING" Classes="TechComment" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="LayersOutline" Foreground="{StaticResource TextMuted}" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Z-INDEX: DEPTH AUTOMATED" Classes="TechComment" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <TextBlock Grid.Column="1"
                           Text="canvas engine · ready"
                           Classes="TechComment"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>