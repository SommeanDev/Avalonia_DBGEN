<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaTestApp.ViewModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="AvaloniaTestApp.Views.AppSettingsView"
             x:DataType="vm:AppSettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="20">

            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <material:MaterialIcon Kind="Cog" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="SYSTEM REGISTRY" Classes="TechHeader" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Application Settings"
                           Foreground="{StaticResource TextBright}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Configure user environment parameters, schema workspaces, and export pipelines."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13"/>
            </StackPanel>

            <Border Background="#090d15"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDark}"
                    CornerRadius="0"
                    Padding="20">
                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="Palette" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="INTERFACE RENDER INTERACTIVE OPTIONS" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Height="1" Background="{StaticResource BorderDark}"/>

                    <Grid ColumnDefinitions="*, 20, *, 20, *">

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Application Theme" Classes="TechHeader" FontSize="11"/>
                            <ComboBox SelectedItem="{Binding SelectedTheme}"
                                      HorizontalAlignment="Stretch"
                                      Height="34"
                                      Background="#070b12"
                                      BorderBrush="{StaticResource BorderDark}"
                                      BorderThickness="1"
                                      CornerRadius="0"
                                      Foreground="{StaticResource TextMain}">
                                <ComboBoxItem>Light</ComboBoxItem>
                                <ComboBoxItem>Dark</ComboBoxItem>
                                <ComboBoxItem>System Default</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Editor Typeface" Classes="TechHeader" FontSize="11"/>
                            <ComboBox SelectedItem="{Binding EditorFont}"
                                      HorizontalAlignment="Stretch"
                                      Height="34"
                                      Background="#070b12"
                                      BorderBrush="{StaticResource BorderDark}"
                                      BorderThickness="1"
                                      CornerRadius="0"
                                      Foreground="{StaticResource TextMain}">
                                <ComboBoxItem>Cascadia Code</ComboBoxItem>
                                <ComboBoxItem>JetBrains Mono</ComboBoxItem>
                                <ComboBoxItem>Consolas</ComboBoxItem>
                                <ComboBoxItem>Fira Code</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Spacing="6">
                            <TextBlock Text="{Binding FontSize, StringFormat='Font Scale: {0}px'}" Classes="TechHeader" FontSize="11"/>
                            <Slider Minimum="10" Maximum="24"
                                    Value="{Binding FontSize}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,4,0,0"/>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#090d15"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDark}"
                    CornerRadius="0"
                    Padding="20">
                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="TuneVariant" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="WORKSPACE CONSOLE CONFIGURATION" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Height="1" Background="{StaticResource BorderDark}"/>

                    <Grid ColumnDefinitions="*, 20, *">
                        <StackPanel Grid.Column="0" Spacing="12">
                            <CheckBox IsChecked="{Binding AutoSaveEnabled}"
                                      Content="Auto-save queries on runtime execute"
                                      Foreground="{StaticResource TextMain}"
                                      FontFamily="{DynamicResource AppFontFamily}"
                                      FontSize="13"/>
                            <CheckBox IsChecked="{Binding ConfirmOnDelete}"
                                      Content="Confirm batch updates before dropping records"
                                      Foreground="{StaticResource TextMain}"
                                      FontFamily="{DynamicResource AppFontFamily}"
                                      FontSize="13"/>
                            <CheckBox IsChecked="{Binding ShowRowNumbers}"
                                      Content="Show continuous row indices in data matrix"
                                      Foreground="{StaticResource TextMain}"
                                      FontFamily="{DynamicResource AppFontFamily}"
                                      FontSize="13"/>
                            <CheckBox IsChecked="{Binding WrapLongLines}"
                                      Content="Wrap trailing lines in terminal viewports"
                                      Foreground="{StaticResource TextMain}"
                                      FontFamily="{DynamicResource AppFontFamily}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Data Fetch Limit Block" Classes="TechHeader" FontSize="11"/>
                            <NumericUpDown Value="{Binding QueryResultLimit}"
                                           Minimum="100" Maximum="100000" Increment="100"
                                           Width="200" HorizontalAlignment="Left"
                                           Height="34"
                                           Background="#070b12"
                                           BorderBrush="{StaticResource BorderDark}"
                                           BorderThickness="1"
                                           CornerRadius="0"
                                           Foreground="{StaticResource TextMain}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#090d15"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDark}"
                    CornerRadius="0"
                    Padding="20">
                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="FolderOpen" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="EXPORT DRIVER &amp; LOCAL FILE TRAFFIC" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Height="1" Background="{StaticResource BorderDark}"/>

                    <Grid ColumnDefinitions="*, 20, *">

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Default Storage Export Workspace" Classes="TechHeader" FontSize="11"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ExportFolderPath}"
                                         Watermark="e.g. C:\SchemaExports"
                                         IsReadOnly="True"
                                         Classes="CyberInput"
                                         Height="34"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding BrowseExportFolderCommand}"
                                        Classes="CyberSecondary"
                                        Height="34" Width="36"
                                        Padding="0"
                                        Margin="6,0,0,0">
                                    <material:MaterialIcon Kind="FolderSearch" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Default Query Script Cache Path" Classes="TechHeader" FontSize="11"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding QuerySavePath}"
                                         Watermark="e.g. C:\QueryVault"
                                         IsReadOnly="True"
                                         Classes="CyberInput"
                                         Height="34"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding BrowseQuerySavePathCommand}"
                                        Classes="CyberSecondary"
                                        Height="34" Width="36"
                                        Padding="0"
                                        Margin="6,0,0,0">
                                    <material:MaterialIcon Kind="FolderSearch" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="File Document Export Array Format" Classes="TechHeader" FontSize="11"/>
                        <ComboBox SelectedItem="{Binding DefaultExportFormat}"
                                  Width="240" HorizontalAlignment="Left"
                                  Height="34"
                                  Background="#070b12"
                                  BorderBrush="{StaticResource BorderDark}"
                                  BorderThickness="1"
                                  CornerRadius="0"
                                  Foreground="{StaticResource TextMain}">
                            <ComboBoxItem>CSV</ComboBoxItem>
                            <ComboBoxItem>Excel Spreadsheet (.xlsx)</ComboBoxItem>
                            <ComboBoxItem>JSON Document Stream</ComboBoxItem>
                            <ComboBoxItem>SQL INSERT Data Scripts</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Background="#090d15"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDark}"
                    CornerRadius="0"
                    Padding="20">
                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="Web" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="REGIONAL TRANSLATION PROTOCOLS" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Height="1" Background="{StaticResource BorderDark}"/>

                    <Grid ColumnDefinitions="*, 20, *, 20, *">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Locale Display Language" Classes="TechHeader" FontSize="11"/>
                            <ComboBox SelectedItem="{Binding SelectedLanguage}"
                                      HorizontalAlignment="Stretch"
                                      Height="34"
                                      Background="#070b12"
                                      BorderBrush="{StaticResource BorderDark}"
                                      BorderThickness="1"
                                      CornerRadius="0"
                                      Foreground="{StaticResource TextMain}">
                                <ComboBoxItem>English</ComboBoxItem>
                                <ComboBoxItem>German</ComboBoxItem>
                                <ComboBoxItem>French</ComboBoxItem>
                                <ComboBoxItem>Japanese</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="System Date Layout" Classes="TechHeader" FontSize="11"/>
                            <ComboBox SelectedItem="{Binding DateFormat}"
                                      HorizontalAlignment="Stretch"
                                      Height="34"
                                      Background="#070b12"
                                      BorderBrush="{StaticResource BorderDark}"
                                      BorderThickness="1"
                                      CornerRadius="0"
                                      Foreground="{StaticResource TextMain}">
                                <ComboBoxItem>DD/MM/YYYY</ComboBoxItem>
                                <ComboBoxItem>MM/DD/YYYY</ComboBoxItem>
                                <ComboBoxItem>YYYY-MM-DD (ISO 8601)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="6">
                            <TextBlock Text="Decimal Separator Type" Classes="TechHeader" FontSize="11"/>
                            <ComboBox SelectedItem="{Binding DecimalSeparator}"
                                      HorizontalAlignment="Stretch"
                                      Height="34"
                                      Background="#070b12"
                                      BorderBrush="{StaticResource BorderDark}"
                                      BorderThickness="1"
                                      CornerRadius="0"
                                      Foreground="{StaticResource TextMain}">
                                <ComboBoxItem>Period ( 1,000.00 )</ComboBoxItem>
                                <ComboBoxItem>Comma  ( 1.000,00 )</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#090d15"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDark}"
                    CornerRadius="0"
                    Padding="20">
                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="CloudSync" Foreground="{StaticResource CyberTeal}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="DISTRIBUTION VERSION CHANNELS" Classes="TechHeader" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Height="1" Background="{StaticResource BorderDark}"/>

                    <CheckBox IsChecked="{Binding AutoCheckUpdates}"
                              Content="Automatically scan patch notes and update arrays on runtime boot"
                              Foreground="{StaticResource TextMain}"
                              FontFamily="{DynamicResource AppFontFamily}"
                              FontSize="13"/>

                    <Grid ColumnDefinitions="Auto, 12, *, 12, Auto" VerticalAlignment="Center">
                        <Button Grid.Column="0"
                                Command="{Binding CheckForUpdatesCommand}"
                                Classes="CyberSecondary"
                                Height="34"
                                Padding="14,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="CloudSearch" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan Package Status" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <TextBlock Grid.Column="2"
                                   Text="{Binding UpdateStatusMessage}"
                                   Classes="TechComment"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                                   
                        <TextBlock Grid.Column="4"
                                   Text="{Binding CurrentVersion, StringFormat='SYSTEM CORE: v{0}'}"
                                   Classes="TechComment"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding StatusColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}"
                               Classes="TechComment"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding ResetCommand}"
                            Classes="CyberSecondary"
                            Height="36"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Restore" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Rollback Defaults" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}"
                            Classes="CyberPrimary"
                            Height="36"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Commit Config" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="ENVIRONMENT PARAMS ARE RUN LOCAL — ENCRYPTED ON INSTANCE DISK"
                       Classes="TechComment"
                       FontSize="10"
                       HorizontalAlignment="Right"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>